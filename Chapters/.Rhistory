library(plotly)
# Generate right-skewed data (e.g., exponential distribution)
set.seed(456)
x <- rexp(1000, rate = 0.7)  # Right-skewed data
# Create histogram (density-normalized)
fig <- plot_ly(
x = ~x,
type = "histogram",
histnorm = "probability density",
nbinsx = 40,
marker = list(
color = "lightblue",
line = list(color = "black", width = 1)
),
opacity = 0.75
) %>%
layout(
title = "Right-Skewed Histogram",
xaxis = list(title = "Value"),
yaxis = list(title = "Density"),
bargap = 0.05
)
fig
