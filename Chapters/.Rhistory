library(plotly)
plot_left_skewed_histogram <- function(n = 1000, bins = 40) {
set.seed(123)
x <- -log(runif(n))^2 + 6
plot_ly(
x = ~x,
type = "histogram",
histnorm = "probability density",
nbinsx = bins,
marker = list(color = "salmon", line = list(color = "black", width = 1)),
name = "Histogram",
opacity = 0.6,
hovertemplate = "Value: %{x}<br>Density: %{y}<extra></extra>"
) %>%
layout(
title = "Left-Skewed Histogram",
xaxis = list(title = "Value"),
yaxis = list(title = "Density")
)
}
