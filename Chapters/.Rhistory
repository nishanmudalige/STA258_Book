library(plotly)
# Generate left-skewed data
set.seed(123)
x <- -log(runif(1000))^2 + 6
# Create histogram (normalized to density scale)
hist_plot <- plot_ly(
x = ~x,
type = "histogram",
histnorm = "probability density",
nbinsx = 40,
marker = list(color = "salmon", line = list(color = "black", width = 1)),
name = "Histogram",
opacity = 0.6,
hovertemplate = "Value: %{x}<br>Density: %{y}<extra></extra>"
) %>%
layout(
title = "Left-Skewed Histogram",
xaxis = list(title = "Value"),
yaxis = list(title = "Density")
)
# Create density curve
density_data <- density(x)
line_plot <- plot_ly(
x = ~density_data$x,
y = ~density_data$y,
type = "scatter",
mode = "lines",
line = list(color = "darkred", width = 2),
name = "Density Curve",
hovertemplate = "x: %{x}<br>Density: %{y}<extra></extra>"
) %>%
layout(
title = "Density Curve",
xaxis = list(title = "Value"),
yaxis = list(title = "Density")
)
# Combine as vertical subplots
fig <- subplot(hist_plot, line_plot, nrows = 2, shareX = TRUE, titleY = TRUE)
fig
