y = c(box_params$Q3 + 0.8, box_params$Q1 - 0.8),
xstart = rep(box_params$x - 0.4, 2),
xend = rep(box_params$x + 0.2, 2)
)
# --- Median reference lines and Q2 label ---
q2_lines <- data.frame(
x = box_params$x - 1.1,
xend = box_params$x + 1.1,
y = box_params$Q2
)
q2_labels <- data.frame(
x = c(0.6, 3.6, 6.6),    # custom x positions for each plot
y = box_params$Q2,       # same y positions as before (Q2 values)
label = "Q2"
)
# --- Vertical and horizontal axes ---
axis_segments <- rbind(
data.frame(x = box_params$x - 1.3, xend = box_params$x - 1.3, y = 1, yend = 6),
data.frame(x = box_params$x - 1.5, xend = box_params$x + 1.2, y = 1, yend = 1)
)
# --- Plot ---
ggplot() +
# Boxes
geom_rect(
data = box_params,
aes(xmin = x - 0.5, xmax = x + 0.5, ymin = Q1, ymax = Q3),
fill = "white", color = "black", linewidth = 1.2
) +
# Median lines
geom_segment(
data = box_params,
aes(x = x - 0.5, xend = x + 0.5, y = Q2, yend = Q2),
linewidth = 1.5
) +
# Whiskers
geom_segment(data = whiskers, aes(x = x, xend = xend, y = y, yend = yend)) +
geom_segment(data = caps, aes(x = xstart, xend = xend, y = y, yend = y)) +
# Axes
geom_segment(data = axis_segments[1:3, ], aes(x = x, xend = xend, y = y, yend = yend), linewidth = 1.2,
arrow = arrow(length = unit(0.2, "cm"))) +
geom_segment(data = axis_segments[4:6, ], aes(x = x, xend = xend, y = y, yend = yend), linewidth = 1.2,
arrow = arrow(length = unit(0.2, "cm"))) +
# Q2 dotted guides
geom_segment(data = q2_lines, aes(x = x, xend = xend, y = y, yend = y), linetype = "dotted") +
geom_text(data = q2_labels, aes(x = x, y = y, label = label), hjust = 1, fontface = "bold", size = 5) +
# Top and bottom annotations
geom_text(data = box_params, aes(x = x, y = 6.1, label = top_label), size = 5) +
geom_text(data = box_params, aes(x = x, y = 0.3, label = bottom_label), size = 4, lineheight = 1) +
theme_void()
