library(ggplot2)
# Generate right-skewed data (mean > median)
set.seed(456)
x <- rbeta(1000, shape1 = 2, shape2 = 5)  # right-skewed
df <- data.frame(value = x)
# Compute summary statistics
mean_val <- mean(df$value)
median_val <- median(df$value)
label_offset <- 0.03  # vertical space between annotations
# Plot
ggplot(df, aes(x = "", y = value)) +
geom_boxplot(fill = "lightgreen", width = 0.3, outlier.shape = NA) +
# Mean point and dashed lines
geom_point(aes(y = mean_val), color = "red", size = 3) +
geom_segment(aes(x = 0.85, xend = 1.15, y = median_val, yend = median_val),
color = "blue", linetype = "dashed") +
geom_segment(aes(x = 0.85, xend = 1.15, y = mean_val, yend = mean_val),
color = "red", linetype = "dashed") +
# Separated annotations
annotate("text", x = 1.25, y = mean_val + label_offset,
label = sprintf("Mean = %.2f", mean_val),
color = "red", hjust = 0, size = 3.8) +
annotate("text", x = 1.25, y = median_val - label_offset,
label = sprintf("Median = %.2f", median_val),
color = "blue", hjust = 0, size = 3.8) +
# Labels and theme
labs(title = "Boxplot: Mean > Median (Right-Skewed)", y = "Value", x = NULL) +
scale_y_continuous(expand = expansion(mult = c(0.05, 0.15))) +
theme_minimal() +
theme(
axis.text.x = element_blank(),
axis.ticks.x = element_blank()
) +
coord_cartesian(clip = "off")
