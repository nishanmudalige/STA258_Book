library(ggplot2)
library(grid)
# Simulate left-skewed data
set.seed(123)
data <- data.frame(
value = c(rnorm(100, mean = 4), rnorm(30, mean = 2))
)
# Compute median
med <- median(data$value)
# Base boxplot
p <- ggplot(data, aes(x = "", y = value)) +
geom_boxplot(width = 0.4, size = 1, outlier.shape = NA) +
# Q2 annotation with dotted line
annotate("text", x = 1.25, y = med, label = "Q2", fontface = "bold", size = 6, hjust = 0) +
geom_segment(aes(x = 1.05, xend = 1.22, y = med, yend = med), linetype = "dotted", linewidth = 0.6) +
geom_segment(aes(x = 0.95, xend = 0.78, y = med, yend = med), linetype = "dotted", linewidth = 0.6) +
# Vertical arrow (Left skew direction)
geom_segment(aes(x = 0.6, xend = 0.6, y = min(data$value) - 0.5, yend = max(data$value) + 0.5),
arrow = arrow(type = "closed", length = unit(0.25, "cm")), size = 0.5) +
# Skew label on top
annotate("text", x = 0.6, y = max(data$value) + 1, label = "Left (negative) skew", size = 5, angle = 0, hjust = 0.5) +
# Horizontal base line
geom_segment(aes(x = 0.4, xend = 1.6, y = min(data$value) - 1, yend = min(data$value) - 1), size = 0.5) +
# Caption below
annotate("text", x = 1, y = min(data$value) - 1.5,
label = "median > mean\n(towards top of data)", size = 5, hjust = 0.5) +
# Theme tweaks
theme_minimal(base_size = 14) +
coord_flip(clip = "off") +
theme(
axis.title = element_blank(),
axis.text  = element_blank(),
axis.ticks = element_blank(),
plot.margin = margin(2, 2, 2, 2, "cm")
)
print(p)
library(ggplot2)
library(grid)
# 1. Create left-skewed data
set.seed(123)
data <- data.frame(
value = c(rnorm(100, mean = 4), rnorm(30, mean = 2))
)
med <- median(data$value)
# 2. Plot
p <- ggplot(data, aes(x = value, y = "")) +
geom_boxplot(width = 0.4, size = 1, outlier.shape = NA) +
# Q2 label and dotted line
annotate("text", y = 1.2, x = med, label = "Q2", fontface = "bold", size = 6, vjust = 0) +
geom_segment(aes(x = med, xend = med, y = 1.05, yend = 1.18),
linetype = "dotted", linewidth = 0.6) +
geom_segment(aes(x = med, xend = med, y = 0.95, yend = 0.78),
linetype = "dotted", linewidth = 0.6) +
# Horizontal arrow (left skew direction)
geom_segment(aes(x = max(data$value) + 0.5, xend = min(data$value) - 0.5, y = 0.6, yend = 0.6),
arrow = arrow(type = "closed", length = unit(0.25, "cm")), size = 0.5) +
# Skew label
annotate("text", y = 0.6, x = min(data$value) - 1.2,
label = "Left (negative) skew", size = 5, hjust = 0) +
# Vertical base line
geom_segment(aes(x = min(data$value) - 1, xend = max(data$value) + 1, y = 0.4, yend = 0.4),
size = 0.5) +
# Caption below
annotate("text", y = 0.2, x = mean(range(data$value)),
label = "median > mean\n(towards top of data)", size = 5, hjust = 0.5) +
# Theme tweaks
theme_minimal(base_size = 14) +
theme(
axis.title = element_blank(),
axis.text  = element_blank(),
axis.ticks = element_blank(),
plot.margin = margin(2, 2, 2, 2, "cm")
)
