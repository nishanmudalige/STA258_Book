library(ggplot2)
library(grid)
# Data setup (1 box only)
box_params <- data.frame(
x = 1,
Q1 = 2.2,
Q2 = 3.9,
Q3 = 4.6
)
# Whiskers
whiskers <- data.frame(
x = rep(1, 2),
xend = rep(1, 2),
y = c(4.6, 2.2),
yend = c(5.4, 1.4)
)
# Caps
caps <- data.frame(
x = c(1, 1),
y = c(5.4, 1.4),
xstart = c(0.8, 0.8),
xend = c(1.2, 1.2)
)
# Median guide line
q2_line <- data.frame(
x = 0.7,
xend = 1.3,
y = 3.9,
yend = 3.9
)
# Q2 label
q2_label <- data.frame(
x = 0.6,
y = 3.9,
label = "Q2"
)
# Axis arrows
axis_segments <- rbind(
data.frame(x = -0.1, xend = -0.1, y = 1, yend = 6),
data.frame(x = -0.5, xend = 1.5, y = 1, yend = 1)
)
# Arrow style
arrow_style <- arrow(length = unit(0.2, "cm"), type = "closed")
# Top and bottom text
top_text <- data.frame(x = 1, y = 6.2, label = "Left (negative) skew")
bottom_text <- data.frame(x = 1, y = 0.3, label = "median > mean\n(towards top of data)")
# Plot
ggplot() +
# Box
geom_rect(data = box_params,
aes(xmin = x - 0.5, xmax = x + 0.5, ymin = Q1, ymax = Q3),
fill = "white", color = "black", linewidth = 1.2) +
# Median
geom_segment(data = box_params,
aes(x = x - 0.5, xend = x + 0.5, y = Q2, yend = Q2),
linewidth = 1.5) +
# Whiskers
geom_segment(data = whiskers,
aes(x = x, xend = xend, y = y, yend = yend), linewidth = 1.2) +
# Whisker caps
geom_segment(data = caps,
aes(x = xstart, xend = xend, y = y, yend = y), linewidth = 1.2) +
# Q2 dotted guide
geom_segment(data = q2_line,
aes(x = x, xend = xend, y = y, yend = yend),
linetype = "dotted") +
# Q2 label
geom_text(data = q2_label,
aes(x = x, y = y, label = label), fontface = "bold", size = 5, hjust = 1) +
# Axes
geom_segment(data = axis_segments[1,],
aes(x = x, xend = xend, y = y, yend = yend),
arrow = arrow_style, linewidth = 1.2) +
geom_segment(data = axis_segments[2,],
aes(x = x, xend = xend, y = y, yend = yend),
arrow = arrow_style, linewidth = 1.2) +
# Annotations
geom_text(data = top_text,
aes(x = x, y = y, label = label), size = 5) +
geom_text(data = bottom_text,
aes(x = x, y = y, label = label), size = 4, lineheight = 1) +
coord_cartesian(xlim = c(-0.5, 2), ylim = c(0, 6.5), clip = "off") +
theme_void()
