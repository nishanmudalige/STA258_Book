# Load necessary package
library(plotly)
# Generate symmetric data (Normal distribution)
set.seed(123)  # for reproducibility
data <- rnorm(1000, mean = 0, sd = 1)
# Create histogram using plotly
fig <- plot_ly(x = ~data, type = "histogram",
marker = list(color = 'rgba(100, 150, 250, 0.7)',
line = list(color = 'rgba(0, 0, 0, 1)', width = 1)),
nbinsx = 30) %>%
layout(title = "Symmetric Histogram (Normal Distribution)",
xaxis = list(title = "Value"),
yaxis = list(title = "Frequency"),
bargap = 0.05)
fig
library(plotly)
# Generate symmetric data (e.g., normal distribution)
set.seed(456)
x <- rnorm(1000, mean = 0, sd = 1)  # Symmetric data
# Create histogram (density-normalized)
fig <- plot_ly(
x = ~x,
type = "histogram",
histnorm = "probability density",
nbinsx = 40,
marker = list(
color = "#00A5FF",
line = list(color = "white", width = 1)
),
opacity = 0.75
) %>%
layout(
title = "Symmetric Histogram",
xaxis = list(title = "Value"),
yaxis = list(title = "Density"),
bargap = 0.05
)
fig
bookdown::render_book()
library(plotly)
# Generate symmetric data (Normal distribution)
set.seed(456)
x <- rnorm(1000, mean = 0, sd = 1)
# Estimate density using built-in density() function
dens <- density(x)
# Create histogram (normalized to density)
fig <- plot_ly() %>%
# Histogram layer
add_trace(
x = ~x,
type = "histogram",
histnorm = "probability density",
nbinsx = 40,
name = "Histogram",
marker = list(
color = "#00A5FF",
line = list(color = "white", width = 1)
),
opacity = 0.6
) %>%
# Density curve layer
add_trace(
x = ~dens$x,
y = ~dens$y,
type = "scatter",
mode = "lines",
name = "Density Curve",
line = list(color = "red", width = 3)
) %>%
layout(
title = "Symmetric Histogram with Approximating Density Curve",
xaxis = list(title = "Value"),
yaxis = list(title = "Density"),
bargap = 0.05
)
fig
# Estimate density from the same data
dens <- density(x)
# Density function as a separate line plot
curve_fig <- plot_ly(
x = ~dens$x,
y = ~dens$y,
type = "scatter",
mode = "lines",
line = list(color = "red", width = 3),
name = "Density"
) %>%
layout(
title = "Approximating Density Function",
xaxis = list(title = "Value"),
yaxis = list(title = "Density")
)
curve_fig
# Estimate density from the same data
dens <- density(x)
# Density function as a separate line plot
curve_fig <- plot_ly(
x = ~dens$x,
y = ~dens$y,
type = "scatter",
mode = "lines",
line = list(color = "#00A5FF", width = 3),
name = "Density"
) %>%
layout(
title = "Approximating Density Function",
xaxis = list(title = "Value"),
yaxis = list(title = "Density")
)
curve_fig
