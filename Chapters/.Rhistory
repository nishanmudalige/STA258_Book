library(ggplot2)
library(grid)
# Left-skewed sample data
set.seed(123)
data <- data.frame(
value = c(rnorm(100, mean = 4), rnorm(30, mean = 2))
)
# Median value for Q2 label
med <- median(data$value)
# Start ggplot
p <- ggplot(data, aes(y = value, x = "")) +
geom_boxplot(width = 0.4, size = 1, outlier.shape = NA) +
# Q2 label with dotted line
annotate("text", x = 1.2, y = med, label = "Q2", fontface = "bold", size = 6, hjust = 0) +
geom_segment(aes(x = 1.05, xend = 1.18, y = med, yend = med),
linetype = "dotted", linewidth = 0.6) +
geom_segment(aes(x = 0.95, xend = 0.78, y = med, yend = med),
linetype = "dotted", linewidth = 0.6) +
# Vertical y-axis arrow (upward)
geom_segment(aes(x = 0.6, xend = 0.6,
y = min(data$value) - 0.5, yend = max(data$value) + 0.8),
arrow = arrow(type = "closed", length = unit(0.25, "cm")),
size = 0.6) +
# Horizontal x-axis at bottom
geom_segment(aes(x = 0.4, xend = 1.6,
y = min(data$value) - 1.2, yend = min(data$value) - 1.2),
size = 0.6) +
# Skew label at top of y-axis
annotate("text", x = 0.6, y = max(data$value) + 1.2,
label = "Left (negative) skew", size = 5, hjust = 0.5) +
# Caption under x-axis
annotate("text", x = 1, y = min(data$value) - 1.8,
label = "median > mean\n(towards top of data)",
size = 5, hjust = 0.5) +
# Theme
coord_flip(clip = "off") +
theme_minimal(base_size = 14) +
theme(
axis.title = element_blank(),
axis.text  = element_blank(),
axis.ticks = element_blank(),
panel.grid = element_blank(),
plot.margin = margin(2, 2, 2, 2, "cm")
)
# Display
print(p)
# Load required package
library(ggplot2)
# Create a left-skewed dataset (e.g., using a beta distribution with alpha > beta)
set.seed(123)
x <- rbeta(1000, shape1 = 5, shape2 = 2)
# Create data frame
df <- data.frame(value = x)
# Plot boxplot
ggplot(df, aes(x = "", y = value)) +
geom_boxplot(fill = "lightblue", width = 0.3) +
stat_summary(fun = mean, geom = "point", shape = 20, size = 3, color = "red") +
labs(title = "Boxplot: Median > Mean", y = "Value") +
theme_minimal() +
theme(axis.title.x = element_blank())
# Load required package
library(ggplot2)
# Generate left-skewed data
set.seed(123)
x <- rbeta(1000, shape1 = 5, shape2 = 2)
df <- data.frame(value = x)
# Compute summary statistics
mean_val <- mean(df$value)
median_val <- median(df$value)
# Plot
ggplot(df, aes(x = "", y = value)) +
geom_boxplot(fill = "lightblue", width = 0.3, outlier.shape = NA) +
# Add mean as red dot
geom_point(aes(y = mean_val), color = "red", size = 3) +
# Annotate mean and median
annotate("text", x = 1.1, y = mean_val, label = sprintf("Mean = %.2f", mean_val),
color = "red", hjust = 0, vjust = -0.5, size = 3.5) +
annotate("text", x = 1.1, y = median_val, label = sprintf("Median = %.2f", median_val),
color = "blue", hjust = 0, vjust = -0.5, size = 3.5) +
# Add horizontal axis line
geom_hline(yintercept = 0, color = "black", linewidth = 0.5) +
# Vertical reference lines
geom_segment(aes(x = 0.85, xend = 1.15, y = median_val, yend = median_val),
color = "blue", linetype = "dashed") +
geom_segment(aes(x = 0.85, xend = 1.15, y = mean_val, yend = mean_val),
color = "red", linetype = "dashed") +
# Titles and axes
labs(title = "Boxplot with Median > Mean (Left-Skewed Distribution)",
y = "Value", x = NULL) +
scale_y_continuous(expand = expansion(mult = c(0.05, 0.1))) +
theme_minimal() +
theme(
axis.text.x = element_blank(),
axis.ticks.x = element_blank()
)
library(ggplot2)
# Generate left-skewed data
set.seed(123)
x <- rbeta(1000, shape1 = 5, shape2 = 2)
df <- data.frame(value = x)
# Compute mean and median
mean_val <- mean(df$value)
median_val <- median(df$value)
# Boxplot with adjusted labels
ggplot(df, aes(x = "", y = value)) +
geom_boxplot(fill = "lightblue", width = 0.3, outlier.shape = NA) +
# Add mean point
geom_point(aes(y = mean_val), color = "red", size = 3) +
# Add dashed lines for mean and median
geom_segment(aes(x = 0.85, xend = 1.15, y = median_val, yend = median_val),
color = "blue", linetype = "dashed") +
geom_segment(aes(x = 0.85, xend = 1.15, y = mean_val, yend = mean_val),
color = "red", linetype = "dashed") +
# Relocated annotations to the right
annotate("text", x = 1.25, y = mean_val,
label = sprintf("Mean = %.2f", mean_val),
color = "red", hjust = 0, vjust = 0.5, size = 3.8) +
annotate("text", x = 1.25, y = median_val,
label = sprintf("Median = %.2f", median_val),
color = "blue", hjust = 0, vjust = 0.5, size = 3.8) +
# Labels and theme
labs(title = "Boxplot: Median > Mean (Left-Skewed)", y = "Value", x = NULL) +
scale_y_continuous(expand = expansion(mult = c(0.05, 0.15))) +
theme_minimal() +
theme(
axis.text.x = element_blank(),
axis.ticks.x = element_blank()
) +
coord_cartesian(clip = "off")  # allow annotations outside plot area
