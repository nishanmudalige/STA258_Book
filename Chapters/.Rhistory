library(plotly)
# Generate left-skewed data (e.g., square of negative log of uniform)
set.seed(123)
x <- -log(runif(1000))^2 + 6
# Create histogram (normalized to density for better visual scaling)
fig <- plot_ly(
x = ~x,
type = "histogram",
histnorm = "probability density",  # Density scale
nbinsx = 40,
marker = list(
color = "salmon",
line = list(color = "black", width = 1)
),
opacity = 0.75
) %>%
layout(
title = "Left-Skewed Histogram",
xaxis = list(title = "Value"),
yaxis = list(title = "Density"),
bargap = 0.05
)
fig
