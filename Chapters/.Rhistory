library(ggplot2)
library(grid)
# Create dummy data with left skew (median > mean)
set.seed(123)
data <- data.frame(
value = c(rnorm(100, mean = 4, sd = 1), rnorm(30, mean = 2, sd = 0.5))
)
# Basic boxplot
p <- ggplot(data, aes(x = "", y = value)) +
geom_boxplot(width = 0.4, size = 1) +
# Q2 annotation
annotate("text", x = 1.2, y = median(data$value), label = "Q2", fontface = "bold", size = 6, hjust = 0) +
geom_segment(aes(x = 1.18, xend = 1.05, y = median(data$value), yend = median(data$value)),
linetype = "dotted", linewidth = 0.6) +
# Left (negative) skew label
annotate("text", x = 1, y = max(data$value) + 0.5, label = "Left (negative) skew", size = 5, hjust = 0.5) +
# Vertical arrow (skew direction)
geom_segment(aes(x = 1.6, xend = 1.6, y = min(data$value) - 1, yend = max(data$value) + 0.3),
arrow = arrow(type = "closed", length = unit(0.2, "cm")), size = 0.5) +
# Horizontal axis line
geom_segment(aes(x = 0.6, xend = 1.4, y = min(data$value) - 1.2, yend = min(data$value) - 1.2),
size = 0.5) +
# Caption
annotate("text", x = 1, y = min(data$value) - 1.8,
label = "median > mean\n(towards top of data)", size = 5, hjust = 0.5) +
coord_flip(clip = "off") +  # Flip axes for vertical box
theme_minimal(base_size = 14) +
theme(
axis.title = element_blank(),
axis.text = element_blank(),
axis.ticks = element_blank(),
plot.margin = margin(2, 2, 2, 2, "cm")
)
print(p)
