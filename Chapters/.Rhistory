fig
library(plotly)
# Generate left-skewed data
set.seed(123)
x <- -log(runif(1000))^2 + 6
# Histogram (normalized to density)
hist_plot <- plot_ly(
x = ~x,
type = "histogram",
histnorm = "probability density",
nbinsx = 40,
marker = list(color = "salmon", line = list(color = "black", width = 1)),
name = "Histogram",
opacity = 0.6,
hovertemplate = "Value: %{x}<br>Density: %{y}<extra></extra>"
)
# Density curve
density_data <- density(x)
line_plot <- plot_ly(
x = ~density_data$x,
y = ~density_data$y,
type = "scatter",
mode = "lines",
line = list(color = "darkred", width = 2),
name = "Density Curve",
hovertemplate = "x: %{x}<br>Density: %{y}<extra></extra>"
)
# Combine with large layout
fig <- subplot(hist_plot, line_plot, shareX = TRUE, shareY = TRUE) %>%
layout(
title = "Left-Skewed Histogram with Density Curve",
xaxis = list(title = "Value", titlefont = list(size = 20), tickfont = list(size = 16)),
yaxis = list(title = "Density", titlefont = list(size = 20), tickfont = list(size = 16)),
barmode = "overlay",
bargap = 0.01,
width = 1400,   # extra wide
height = 800    # extra tall
)
fig
