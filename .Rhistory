# Cigarettes needed for predicted birth weight of 125 ounces
cigs_needed <- (125 - coef(model1)[1]) / coef(model1)[2]
round(cigs_needed, 3)
# Number of women smoking zero cigarettes per day
sum(births$cigs == 0)
# Import the dataset
births <- read.csv("data/bwght.csv")
# Number of observations
nrow(births)
# Check missing values in the three variables
colSums(is.na(births[, c("bwght", "cigs", "faminc")]))
# Estimate the simple regression
model1 <- lm(bwght ~ cigs, data = births)
# Display regression results
summary(model1)
# Cigarettes needed for predicted birth weight of 125 ounces
cigs_needed <- (125 - coef(model1)[1]) / coef(model1)[2]
round(cigs_needed, 3)
# Number of women smoking zero cigarettes per day
sum(births$cigs == 0)
# Proportion smoking zero cigarettes per day
prop_zero <- mean(births$cigs == 0)
round(prop_zero, 4)
# Predicted birth weight at zero cigarettes
predict(model1, newdata = data.frame(cigs = 0))
# Correlation between smoking and family income
round(cor(births$cigs, births$faminc), 4)
# Import the dataset
votes <- read.csv("data/vote1.csv")
# Number of observations
nrow(votes)
# Check missing values in the model variables
colSums(is.na(votes[, c("voteA", "expendA", "expendB", "prtystrA")]))
# Estimate the multiple regression
model3 <- lm(voteA ~ expendA + expendB + prtystrA, data = votes)
# Display regression results
summary(model3)
# Calculate the effect of $100,000 more expenditure
effect_100k <- 100 * coef(model3)["expendA"]
round(effect_100k, 4)
# Hypotheses
# H0: beta1 <= 0.04
# H1: beta1 > 0.04
# Extract coefficient and standard error
beta_A <- coef(model3)["expendA"]
se_A <- summary(model3)$coefficients["expendA", "Std. Error"]
beta_A
se_A
# Calculate t-statistic at the null boundary (0.04)
t_stat_A <- (beta_A - 0.04) / se_A
t_stat_A
# Residual degrees of freedom
df_A <- df.residual(model3)
df_A
# 5% right-tailed critical value
t_critical_A <- qt(0.95, df_A)
t_critical_A
# Calculate one-sided p-value
p_value_A <- pt(t_stat_A, df_A, lower.tail = FALSE)
p_value_A
# Compare with R's default two-sided p-value
summary(model3)$coefficients["expendA", "Pr(>|t|)"]
# Import the dataset
births <- read.csv("data/bwght.csv")
# Number of observations
nrow(births)
# Check missing values in the three variables
colSums(is.na(births[, c("bwght", "cigs", "faminc")]))
# Estimate the simple regression
model1 <- lm(bwght ~ cigs, data = births)
# Display regression results
summary(model1)
# Cigarettes needed for predicted birth weight of 125 ounces
cigs_needed <- (125 - coef(model1)[1]) / coef(model1)[2]
round(cigs_needed, 3)
# Number of women smoking zero cigarettes per day
sum(births$cigs == 0)
# Proportion smoking zero cigarettes per day
prop_zero <- mean(births$cigs == 0)
round(prop_zero, 4)
# Predicted birth weight at zero cigarettes
predict(model1, newdata = data.frame(cigs = 0))
# Correlation between smoking and family income
round(cor(births$cigs, births$faminc), 4)
# Estimate multiple regression
model2 <- lm(bwght ~ cigs + faminc, data = births)
# Display regression results
summary(model2)
# Check that both models use the same observations
nobs(model1)
nobs(model2)
# Compare smoking coefficients
coef(model1)["cigs"]
coef(model2)["cigs"]
# Calculate change in smoking coefficient
coef(model2)["cigs"] - coef(model1)["cigs"]
# Compare R-squared values
summary(model1)$r.squared
summary(model2)$r.squared
# Import the dataset
votes <- read.csv("data/vote1.csv")
# Number of observations
nrow(votes)
# Check missing values in the model variables
colSums(is.na(votes[, c("voteA", "expendA", "expendB", "prtystrA")]))
# Estimate the multiple regression
model3 <- lm(voteA ~ expendA + expendB + prtystrA, data = votes)
# Display regression results
summary(model3)
# Calculate the effect of $100,000 more expenditure
effect_100k <- 100 * coef(model3)["expendA"]
round(effect_100k, 4)
# Extract coefficient and standard error
beta_B <- coef(model3)["expendB"]
se_B <- summary(model3)$coefficients["expendB", "Std. Error"]
beta_B
se_B
# Calculate t-statistic
t_stat <- beta_B / se_B
t_stat
# Residual degrees of freedom
df <- df.residual(model3)
df
# 5% two-sided critical value
t_critical <- qt(0.975, df)
t_critical
# Calculate two-sided p-value
p_value <- 2 * pt(-abs(t_stat), df)
p_value
# Compare with regression summary p-value
summary(model3)$coefficients["expendB", "Pr(>|t|)"]
# Hypotheses
# H0: beta1 <= 0.04
# H1: beta1 > 0.04
# Extract coefficient and standard error
beta_A <- coef(model3)["expendA"]
se_A <- summary(model3)$coefficients["expendA", "Std. Error"]
beta_A
se_A
# Calculate t-statistic at the null boundary (0.04)
t_stat_A <- (beta_A - 0.04) / se_A
t_stat_A
# Residual degrees of freedom
df_A <- df.residual(model3)
df_A
# 5% right-tailed critical value
t_critical_A <- qt(0.95, df_A)
t_critical_A
# Calculate one-sided p-value
p_value_A <- pt(t_stat_A, df_A, lower.tail = FALSE)
p_value_A
# Compare with R's default two-sided p-value
summary(model3)$coefficients["expendA", "Pr(>|t|)"]
# Extract coefficient and standard error
beta_A <- coef(model3)["expendA"]
se_A <- summary(model3)$coefficients["expendA", "Std. Error"]
# 95% two-sided critical value
df_A <- df.residual(model3)
t_crit_95 <- qt(0.975, df_A)
t_crit_95
# Calculate confidence interval manually
ci_lower <- beta_A - t_crit_95 * se_A
ci_upper <- beta_A + t_crit_95 * se_A
ci_manual <- c(lower = ci_lower, upper = ci_upper)
ci_manual
# Verify using confint()
confint(model3, "expendA", level = 0.95)
# Convert interval to $100,000 additional expenditure
ci_100k <- 100 * ci_manual
ci_100k
# Check whether the interval contains 4 percentage points
ci_100k[1] <= 4 && 4 <= ci_100k[2]
# Create expenditure variable in units of $100,000
votes$expendA100 <- votes$expendA / 100
# Estimate the rescaled regression
model4 <- lm(voteA ~ expendA100 + expendB + prtystrA,
data = votes)
# Display regression results
summary(model4)
# Compare coefficient rows
summary(model3)$coefficients["expendA", ]
summary(model4)$coefficients["expendA100", ]
# Check whether fitted values are unchanged
all.equal(fitted(model3), fitted(model4))
# Null boundary from part (c) in new units
null_boundary <- 4
null_boundary
