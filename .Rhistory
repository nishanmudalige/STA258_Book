# Compute the auxiliary variable u = d^2/R^2 - d^4/(4R^4)
u <- (d^2 / R^2) - (d^4 / (4 * R^4))
# Clamp u to [0,1] for numerical stability
u <- pmin(pmax(u, 0), 1)
# Determine the threshold sqrt(2)*R
threshold <- sqrt(2) * R
# Compute the piecewise CDF using pbeta for the regularized incomplete beta
cdf <- ifelse(
d < threshold,
0.5 * pbeta(u, (N - 0) / 2, 1 / 2),
1 - 0.5 * pbeta(u, (N - 0) / 2, 1 / 2)
)
# Enforce the domain limits
cdf[d < 0]       <- 0
cdf[d > 2 * R]   <- 1
return(cdf)
}
