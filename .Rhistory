### sample size changes if effect size is smaller , variability is larger
## sample size
pow <- power.t.test(n = 30, delta = seq(0.01, 2, by = 0.1), sd = sp,
power = NULL, type = "two.sample",
alternative = "two.sided", strict = TRUE)
mean_A <- mean(yA)
mean_B <- mean(yB)
diff_AB <- mean_A - mean_B
nA <- length(yA)
nB <- length(yB)
sd_A <- sd(yA)
sd_B <- sd(yB)
sp <- sqrt(((nA - 1) * sd_A^2 + (nB - 1) * sd_B^2) / (nA + nB - 2))
delta_obs <- abs(diff_AB)
#effect size
d_obs <- delta_obs / sp
#sample size
power_result = power.t.test(delta = delta_obs, sd = sp, sig.level = 0.05, power = 0.80)
n_required = ceiling(power_result$n)
### Estimate power at the required sample size
set.seed(1111)
pvals <- replicate(10000,
t.test(rnorm(n_required, mean = mean_A, sd = sd_A),
rnorm(n_required, mean = mean_B, sd = sd_B),
var.equal = TRUE)$p.value)
power_sim <- sum(pvals <= 0.05) / 10000
power_sim
### sample size changes if effect size is smaller , variability is larger
## sample size
