# 1. Install 'svgparser' if missing
# remotes::install_github("coolbutuseless/svgparser")
library(svgparser)
# 2. Read SVG as data.frames
svg_url <- "https://raw.githubusercontent.com/nishanmudalige/STA258/14fbd7379265761a203c30ffb1e235954dd068a4/Hex%20Badges/STA258.svg"
svg_data <- svgparser::read_svg(svg_url, as = "data.frame")
# 1. INSTALL AND LOAD PACKAGES
# ----------------------------
# Make sure you have the necessary packages installed
if (!require("rgl")) install.packages("rgl")
if (!require("xml2")) install.packages("xml2")
if (!require("svgparser")) install.packages("svgparser")
if (!require("stringr")) install.packages("stringr")
library(rgl)
library(xml2)
library(svgparser)
library(stringr)
# 2. DOWNLOAD AND PARSE THE SVG
# -----------------------------
# URL of the SVG file
url <- "https://raw.githubusercontent.com/nishanmudalige/STA258/14fbd7379265761a203c30ffb1e235954dd068a4/Hex%20Badges/STA258.svg"
# Read the SVG content from the URL
svg_content <- read_xml(url)
ns <- xml_ns(svg_content) # Get XML namespace
# 3. EXTRACT STYLE INFORMATION (COLORS)
# -------------------------------------
# This SVG uses CSS classes to define colors. We need to parse them.
style_text <- xml_text(xml_find_first(svg_content, ".//d1:style", ns))
styles <- str_extract_all(style_text, "\\.st[0-9]+\\{fill:#[0-9A-Fa-f]{6};\\}")[[1]]
# Create a named list to store colors for each class
color_map <- list()
for (style in styles) {
class_name <- str_extract(style, "\\.st[0-9]+")
hex_color <- str_extract(style, "#[0-9A-Fa-f]{6}")
# The class name in the style tag has a '.', but not in the path tag
color_map[[str_remove(class_name, "\\.")]] <- hex_color
}
# 4. PREPARE THE RGL SCENE
# ------------------------
open3d(windowRect = c(50, 50, 550, 550)) # Create a window
bg3d("white") # Set background color
rgl.viewpoint(theta = 0, phi = 0, fov = 0, zoom = 0.65) # Set a 2D-like view
light3d(specular = "black") # Add a light source
# 5. PROCESS AND PLOT EACH PATH
# -----------------------------
# Find all <path> elements in the SVG
paths <- xml_find_all(svg_content, ".//d1:path", ns)
# Loop through each path, extract its shape and color, and plot it
for (i in 1:length(paths)) {
path <- paths[[i]]
# Get the path's drawing instructions (the 'd' attribute)
path_d <- xml_attr(path, "d")
# Determine the color of the path
path_color <- xml_attr(path, "fill") # Check for a direct fill attribute
if (is.na(path_color)) {
# If no direct fill, look for a class and use our color map
path_class <- xml_attr(path, "class")
if (!is.na(path_class) && path_class %in% names(color_map)) {
path_color <- color_map[[path_class]]
} else {
path_color <- "black" # Default color if none found
}
}
# Parse the SVG path data into a list of matrices with x, y coordinates
parsed_path <- svg_parse_path(path_d)
# Draw each sub-path as a polygon in rgl
for (shape in parsed_path) {
if (nrow(shape) > 1) {
# Add a z-coordinate (set to a small value based on loop index to avoid overlap)
shape_3d <- cbind(shape, z = -i * 0.01)
# Plot the shape as a polygon
polygon3d(shape_3d, color = path_color, lit = TRUE)
}
}
}
