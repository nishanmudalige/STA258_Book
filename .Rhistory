m_cdf = zipfR::Ibeta( (d_u^2)/(4*r^2), dim/2, dim/2) / beta(dim/2, dim/2)
r = 1
# d_u distance of uniform points
m_cdf = zipfR::Ibeta( (d_u^2)/(4*r^2), dim/2, dim/2) / beta(dim/2, dim/2)
ks_statistic_pvalue_from_cdfs(ecdf_y, m_cdf, nA = length(ecdf_y), nB = length(m_cdf))
plot(d_u, m_cdf)
