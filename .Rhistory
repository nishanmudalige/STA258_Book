library(rgl)
library(png)
library(RCurl)
# 1. load & flip
myurl <- "https://raw.githubusercontent.com/nishanmudalige/STA258/main/Hex%20Badges/STA258_no_bg.png"
img   <- readPNG(getURLContent(myurl))
img   <- img[nrow(img):1, , ]
# 2. flatten over white
alpha      <- img[,,4]
img[,,1]   <- img[,,1] * alpha + (1 - alpha)
img[,,2]   <- img[,,2] * alpha + (1 - alpha)
img[,,3]   <- img[,,3] * alpha + (1 - alpha)
img[,,4]   <- 1
# 3. build quad
h  <- dim(img)[1]; w <- dim(img)[2]; sf <- max(w, h) / 2
front <- matrix(c(
-w/2, -h/2, 0,
w/2, -h/2, 0,
w/2,  h/2, 0,
-w/2,  h/2, 0
), byrow=TRUE, ncol=3) / sf
front <- rotate3d(front, angle = pi/2, x = 1, y = 0, z = 0)
# 3a. scale the quad (50% smaller)
scale_factor <- 0.5
front <- front * scale_factor
# alternatively: front <- scale3d(front, scale_factor, scale_factor, scale_factor)
# 4. texture coords
tex <- matrix(c(
0,0,
1,0,
1,1,
0,1
), byrow = TRUE, ncol = 2)
# 5. draw & embed
invisible(open3d())                # suppress device message
bg3d("white")
view3d(theta = 0, phi = -90, zoom = 0.675)
invisible(quads3d(
front,
texture   = img,
texcoords = tex,
lit       = FALSE,
col       = "white"
))
