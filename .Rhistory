hypersphere_uniform_points = function(n, dim){
# generate points
pts_unif = matrix(rnorm(n*dim), ncol = dim)
# normalize
pts_unif = sqrt(rowSums(pts_u^2))
return(pts_unif)
}
hypersphere_uniform_points(100, 3)
