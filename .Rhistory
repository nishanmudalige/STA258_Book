# method 1: use interaction model coefficients
int.model <- lm(y ~ A*B*C, data = wtlossdat)
A.effect   <- 2 * coefficients(int.model)["A"]
B.effect   <- 2 * coef(int.model)["B"]
C.effect   <- 2 * coef(int.model)["C"]
AB.effect  <- 2 * coef(int.model)["A:B"]
AC.effect  <- 2 * coef(int.model)["A:C"]
BC.effect  <- 2 * coef(int.model)["B:C"]
ABC.effect <- 2 * coef(int.model)["A:B:C"]
effects.coef <- data.frame(
Effect = c("A","B","C","AB","AC","BC","ABC"),
Estimate = c(A.effect, B.effect, C.effect, AB.effect, AC.effect, BC.effect, ABC.effect)
)
effects.coef
round(2*int.model$coefficients,2)
