library(rgl)
library(rsvg)
library(png)
url_svg <- "https://raw.githubusercontent.com/nishanmudalige/STA258/14fbd7379265761a203c30ffb1e235954dd068a4/Hex%20Badges/STA258.svg"
tmp_svg <- tempfile(fileext = ".svg")
tmp_png <- tempfile(fileext = ".png")
download.file(url_svg, tmp_svg, mode = "wb")
rsvg_png(tmp_svg, file = tmp_png, width = 2048, height = 2048)
# --- NEW BLOCK: read, mask zeros, overwrite PNG ---
img <- png::readPNG(tmp_png)
img[ img == 0 ] <- NA
img[1,1,1]
png::writePNG(img, tmp_png)
# now compute dimensions from the (masked) img
h      <- dim(img)[1]
w      <- dim(img)[2]
aspect <- w / h
open3d()
rgl.bg(color = "white")    # or transparent, as you prefer
material3d(lit = FALSE, texture = tmp_png, specular = "black")
x <- c(-aspect,  aspect,  aspect, -aspect)
y <- c(-1,        -1,       1,       1)
z <- rep(0, 4)
texcoords <- matrix(c(0,0, 1,0, 1,1, 0,1), ncol = 2, byrow = TRUE)
quads3d(x, y, z, texcoords = texcoords, col = "white")
rglwidget()
