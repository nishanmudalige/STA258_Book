library(ggplot2)
# Example data vector (replace with your own)
set.seed(42)
df <- data.frame(
Value = c(5, 12, 18, 22, 25, 27, 30, 31, 33, 36,
38, 40, 42, 45, 47, 50, 52, 55, 58, 62)
)
ggplot(df, aes(x = Value)) +
geom_histogram(
breaks = seq(0, 70, by = 10),       # define bin boundaries :contentReference[oaicite:0]{index=0}
fill   = "#9ecae1",                 # light blue fill             :contentReference[oaicite:1]{index=1}
color  = "black",                   # black border                :contentReference[oaicite:2]{index=2}
alpha  = 0.6                        # semi‑transparent fill       :contentReference[oaicite:3]{index=3}
) +
scale_x_continuous(
breaks = seq(10, 60, by = 10)       # tick marks at 10,20,…,60
) +
scale_y_continuous(
breaks = seq(1, 5, by = 1)          # tick marks at 1,2,…,5
) +
labs(x = "Value", y = "Frequency") +
theme_minimal(base_size = 14) +
theme(
axis.title.x = element_text(margin = margin(t = 10)_
