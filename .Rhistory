library(png)
library(plotly)
# 1. Load the image
img <- readPNG("~/Desktop/STA258/Hex Badges/STA258.png")
# 2. Get dimensions
nr <- nrow(img)  # image height (rows)
nc <- ncol(img)  # image width  (columns)
# 3. Build normalized x/y coordinates
x_coords <- seq(0, 1, length.out = nc)
y_coords <- seq(0, 1, length.out = nr)
# 4. Flatten into vertex arrays
x <- rep(x_coords, each = nr)
y <- rep(y_coords, nc)
z <- rep(0, length(x))  # flat plane at z = 0
# 5. Create triangle indices (i, j, k) and face colors
i_idx <- integer()
j_idx <- integer()
k_idx <- integer()
face_color <- character()
for (row in 1:(nr - 1)) {
for (col in 1:(nc - 1)) {
# zero‐based indices for the four corners of each cell
v1 <- (col - 1) * nr + (row - 1)
v2 <- (col - 1) * nr +  row
v3 <-  col      * nr + (row - 1)
v4 <-  col      * nr +  row
# two triangles per cell
i_idx <- c(i_idx, v1, v1)
j_idx <- c(j_idx, v2, v4)
k_idx <- c(k_idx, v4, v3)
# sample the RGBA pixel, convert to hex string
pix <- img[row, col, ]
hex <- rgb(pix[1], pix[2], pix[3], pix[4])
face_color <- c(face_color, hex, hex)
}
}
fig
# Function to compute the CDF using Sidiropoulos technique
# N = dimensionality of the space (2 for S²)
sidiropoulos_cdf <- function(d, N, R = 1) {
# Compute the auxiliary variable u = d^2/R^2 - d^4/(4R^4)
u <- (d^2 / R^2) - (d^4 / (4 * R^4))
# Clamp u to [0,1] for numerical stability
u <- pmin(pmax(u, 0), 1)
# Determine the threshold sqrt(2)*R
threshold <- sqrt(2) * R
# Compute the piecewise CDF using pbeta for the regularized incomplete beta
cdf <- ifelse(
d < threshold,
0.5 * pbeta(u, (N - 0) / 2, 1 / 2),
1 - 0.5 * pbeta(u, (N - 0) / 2, 1 / 2)
)
# Enforce the domain limits
cdf[d < 0]       <- 0
cdf[d > 2 * R]   <- 1
return(cdf)
}
# generate uniform endpoints on S^2
n = 120
pts_u <- matrix(rnorm(2*n), ncol=4)
# Normalize points to unit sphere
pts_u <- pts_u / sqrt(rowSums(pts_u^2))
# pairwise chord lengths for uniform points
d_u <- as.vector(dist(pts_u))
d_u = sort(d_u)
# N is the dimensino. N=3 for S^2
Sid_F <- sidiropoulos_cdf(d_u, N=3, R=1)
plot(sort(d_u), Sid_F, type="l")
# ECDF
ecdf_u <- ecdf(d_u)
plot( ecdf_u )
#’ @return A list with elements
#’   - statistic: KS statistic D
#’   - p.value: two-sided p-value
#’ @examples
#’ # Suppose we have two samples of sizes 50 and 60:
#’ x <- sort(runif(50)); y <- sort(rnorm(60))
#’ # Evaluate their ECDFs on a common grid:
#’ grid <- sort(unique(c(x, y)))
#’ F_A <- ecdf(x)(grid); F_B <- ecdf(y)(grid)
#’ ks_statistic_pvalue_from_cdfs(F_A, F_B, nA = 50, nB = 60)
ks_statistic_pvalue_from_cdfs <- function(F_A, F_B, nA, nB, K = 100) {
# Input checks
if (!is.numeric(F_A) || !is.numeric(F_B)) {
stop("F_A and F_B must be numeric vectors.")
}
if (length(F_A) != length(F_B)) {
stop("F_A and F_B must have the same length (evaluated on a common grid).")
}
if (length(nA) != 1 || length(nB) != 1 ||
nA <= 0 || nB <= 0 || nA != floor(nA) || nB != floor(nB)) {
stop("nA and nB must be positive integers.")
}
# 1. KS statistic D
D <- max(abs(F_A - F_B), na.rm = TRUE)
# 2. Scale to lambda
lambda <- D * sqrt((nA * nB) / (nA + nB))
# 3. Compute two‐sided p‐value via asymptotic series
terms <- sapply(1:K, function(k) {
2 * (-1)^(k - 1) * exp(-2 * (k^2) * (lambda^2))
})
p_val <- sum(terms)
# Clamp to [0,1]
p_val <- min(max(p_val, 0), 1)
return(list(statistic = D, p.value = p_val))
}
env = environment(ecdf_u)
ecdf_y = env$y
ks_statistic_pvalue_from_cdfs(ecdf_y, Sid_F, nA = length(ecdf_y), nB = length(Sid_F))
