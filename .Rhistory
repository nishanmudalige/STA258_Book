# Load the necessary libraries
library(rgl)
library(Rvcg)
install.packages("Rvcg", dependencies = T)
# Load the necessary libraries
library(rgl)
library(Rvcg)
# URL of the original SVG file
svg_url <- "https://raw.githubusercontent.com/nishanmudalige/STA258/14fbd7379265761a203c30ffb1e235954dd068a4/Hex%20Badges/STA258.svg"
# After converting the SVG to STL online, provide the path to the STL file
# For example, if you saved the converted file as "STA258.stl" in your working directory
stl_file_path <- "STA258.stl" # Make sure to update this with your actual file path
# Check if the file exists before attempting to load it
if (file.exists(stl_file_path)) {
# Load the STL file as a mesh object
hex_mesh <- vcgImport(stl_file_path)
# Clear the current rgl scene
rgl.clear()
# Open a new rgl window
open3d()
# Display the mesh object
shade3d(hex_mesh, col = "blue") # You can change the color as you like
# You can also add lights and a background color
light3d(theta = 45, phi = 45)
bg3d("white")
# Set the viewpoint for a good initial view
rgl.viewpoint(theta = 0, phi = -30, fov = 60, zoom = 0.8)
} else {
cat("Error: The file was not found at the specified path.\n")
cat("Please make sure the STL file is in your R working directory or provide the full path.\n")
}
