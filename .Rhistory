library(rgl)
library(magick)
library(htmlwidgets)
library(rgl)
library(rsvg)
library(png)
library(htmlwidgets)
# view3d(theta=0, phi=0, zoom=0.675) # smaller values means zoom in
# install.packages(c("rgl", "magick", "htmlwidgets"))  # if needed
library(rgl)
library(magick)
library(htmlwidgets)
library(rgl)
library(rsvg)
library(png)
library(htmlwidgets)
url_svg <- "https://raw.githubusercontent.com/nishanmudalige/STA258/14fbd7379265761a203c30ffb1e235954dd068a4/Hex%20Badges/STA258.svg"
# 1) Read SVG and rasterize to PNG **with transparency preserved**
img <- image_read_svg(url_svg, width = 2048, height = 2048)
tmp_png <- tempfile(fileext = ".png")
image_write(img, path = tmp_png, format = "png")
# 2) Aspect ratio for the textured quad
info    <- image_info(img)
aspect  <- info$width / info$height
# 3) rgl scene with a fully transparent canvas
open3d()
par3d(opaque = FALSE)                                # <- KEY: make the WebGL canvas non-opaque
bg3d(col = grDevices::adjustcolor("white", 0))       # transparent background
rgl.material(lit = FALSE, texture = tmp_png, specular = "black")
x <- c(-aspect,  aspect,  aspect, -aspect)
y <- c(-1,      -1,       1,       1)
z <- rep(0, 4)
texcoords <- matrix(c(0,0, 1,0, 1,1, 0,1), ncol = 2, byrow = TRUE)
quads3d(x, y, z,
texcoords = texcoords,
col = "#FFFFFF00")                           # make the underlying quad itself transparent
# 4) Force the HTML widget's CSS background to be transparent too
rglwidget() %>%
onRender("
function(el, x) {
el.style.background = 'transparent';
var c = el.querySelector('canvas');
if (c) c.style.background = 'transparent';
}
")
