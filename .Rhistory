fmt_num <- function(x, d = 3) formatC(x, format = "f", digits = d)
fmt_p <- function(p) {
if (is.na(p)) return(NA_character_)
if (p < 0.001) "< 0.001" else formatC(p, format = "f", digits = 3)
}
code_two_level <- function(x) {
if (is.factor(x) || is.character(x)) {
ux <- sort(unique(as.character(x)))
if (length(ux) != 2) stop("Variable does not have exactly two levels.")
ifelse(as.character(x) == ux[1], -1, 1)
} else {
ux <- sort(unique(x))
if (length(ux) != 2) stop("Variable does not have exactly two levels.")
ifelse(x == ux[1], -1, 1)
}
}
infer_rbd_vars <- function(df) {
num_cols <- names(df)[sapply(df, is.numeric)]
fac_cols <- names(df)[sapply(df, function(x) is.factor(x) || is.character(x))]
if (length(num_cols) == 0 || length(fac_cols) < 2) {
stop("shoedat_obs does not have the expected structure.")
}
response <- num_cols[1]
nlev <- sapply(df[fac_cols], function(x) dplyr::n_distinct(x))
treatment <- fac_cols[which.min(abs(nlev - 2))]
remaining <- setdiff(fac_cols, treatment)
block <- remaining[which.max(nlev[remaining])]
list(response = response, treatment = treatment, block = block)
}
