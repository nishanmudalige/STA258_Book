# app.R
# Interactive histogram with adjustable bin width
# ------------------------------------------------
library(shiny)
ui <- fluidPage(
titlePanel("Interactive Histogram – Adjust Bin Width"),
sidebarLayout(
sidebarPanel(
sliderInput(
inputId = "binwidth",
label   = "Bin width:",
min     = 0.1,      # smallest bin width allowed
max     = 5,        # largest bin width allowed
value   = 1,        # initial bin width
step    = 0.1
),
helpText("Data: 'waiting' times between eruptions in the ",
"faithful (Old Faithful) dataset.")
),
mainPanel(
plotOutput(outputId = "histPlot", height = 450)
)
)
)
server <- function(input, output, session) {
output$histPlot <- renderPlot({
x <- faithful$waiting                          # numeric vector
# Generate a sequence of break points based on the chosen bin width
breaks <- seq(
floor(min(x)),
ceiling(max(x) + input$binwidth),            # ensure last bin closes
by = input$binwidth
)
hist(
x,
breaks = breaks,
col    = "#1f77b4",
border = "white",
xlab   = "Waiting time between eruptions (minutes)",
main   = paste("Histogram (bin width =", input$binwidth, ")")
)
}, res = 96)    # res controls resolution of the PNG generated by Shiny
}
shinyApp(ui, server)
# app.R
# Interactive histogram with adjustable bin width
# ------------------------------------------------
library(shiny)
ui <- fluidPage(
titlePanel("Interactive Histogram – Adjust Bin Width for the Faithful Dataset"),
sidebarLayout(
sidebarPanel(
sliderInput(
inputId = "binwidth",
label   = "Bin width:",
min     = 0.1,      # smallest bin width allowed
max     = 5,        # largest bin width allowed
value   = 1,        # initial bin width
step    = 0.1
),
helpText("Data: 'waiting' times between eruptions in the ",
"faithful (Old Faithful) dataset.")
),
mainPanel(
plotOutput(outputId = "histPlot", height = 450)
)
)
)
server <- function(input, output, session) {
output$histPlot <- renderPlot({
x <- faithful$waiting                          # numeric vector
# Generate a sequence of break points based on the chosen bin width
breaks <- seq(
floor(min(x)),
ceiling(max(x) + input$binwidth),            # ensure last bin closes
by = input$binwidth
)
hist(
x,
breaks = breaks,
col    = "#1f77b4",
border = "white",
xlab   = "Waiting time between eruptions (minutes)",
main   = paste("Histogram (bin width =", input$binwidth, ")")
)
}, res = 96)    # res controls resolution of the PNG generated by Shiny
}
shinyApp(ui, server)
runApp('~/Desktop/Histogram RShiny App/Histogram_Bin_Width_App.R')
