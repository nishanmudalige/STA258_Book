\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Interactive plot of a histogram created with \texttt  {plotly} which can show or hide the density plot superimposed over the histogram when the user clicks the \textit  {Show/Hide Density} button on the plot.}}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:interactive_hist_plotly}{{5}{10}{Interactive plot of a histogram created with \texttt {plotly} which can show or hide the density plot superimposed over the histogram when the user clicks the \textit {Show/Hide Density} button on the plot}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Interactive plot of a boxplot created with \texttt  {plotly} where the information changes based on the component of the plot where the user hover over with their cursor. Note in this particular example, the baseline plot does not display any text labels when the cursor does not hover over it.}}{10}{figure.caption.8}\protected@file@percent }
\newlabel{fig:interactive_boxplot_plotly}{{6}{10}{Interactive plot of a boxplot created with \texttt {plotly} where the information changes based on the component of the plot where the user hover over with their cursor. Note in this particular example, the baseline plot does not display any text labels when the cursor does not hover over it}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Interactive application created using \texttt  {shiny} that allows students to adjust the bin width for a histogram which was built with real-world data. This specific used the \textit  {faithful} data set which has waiting times for the Old Faithful geyser in Yellowstone National Park. The tool demonstrates how the appearance of a histogram is sensitive to graphical parameters, enhancing understanding of distribution shape and granularity. Notice the title of the histogram also updates based on the numeric value of the bin width the slider has been set to.}}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:interactive_hist_shiny}{{7}{11}{Interactive application created using \texttt {shiny} that allows students to adjust the bin width for a histogram which was built with real-world data. This specific used the \textit {faithful} data set which has waiting times for the Old Faithful geyser in Yellowstone National Park. The tool demonstrates how the appearance of a histogram is sensitive to graphical parameters, enhancing understanding of distribution shape and granularity. Notice the title of the histogram also updates based on the numeric value of the bin width the slider has been set to}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Interactive application which simulates data points based on the correlation and the number of points selected. This allows the user to observe various strengths of positive and negative correlation. The user can also show or hide the ordinary least square regression line on the plot.}}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:interactive_corr_shiny}{{8}{11}{Interactive application which simulates data points based on the correlation and the number of points selected. This allows the user to observe various strengths of positive and negative correlation. The user can also show or hide the ordinary least square regression line on the plot}{figure.caption.10}{}}
